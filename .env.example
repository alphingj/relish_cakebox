# Copy to .env.local and fill in.

# Admin password for /relish (required in production)
ADMIN_PIN=

# Postgres (Neon via Vercel Marketplace) - shared gallery, prices, site content
DATABASE_URL=

# Vercel Blob (public store). On Vercel this is injected automatically;
# for local development copy the read-write token from the store settings.
BLOB_READ_WRITE_TOKEN=

# Public site URL used by metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000
